# Postgres
DATABASE_URL=postgres://salon:salon@localhost:5432/salon

# Server
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000

# Optional ESC/POS network thermal printer (reception workstation)
# When unset, the server falls back to browser printing only.
ESCPOS_ENABLED=false
ESCPOS_INTERFACE=tcp://192.168.1.50:9100
ESCPOS_CHARACTER_SET=PC437_USA
ESCPOS_WIDTH=42

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
